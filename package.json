{
  "name": "openmirasim-workspace",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @openmirasim/web dev",
    "build": "pnpm --filter @openmirasim/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @openmirasim/web test",
    "test:e2e": "pnpm --filter @openmirasim/e2e test"
  }
}
